# URL del backend (con /api). En producción hay que definirla SIEMPRE.
# Sin definir usa el backend local de desarrollo (puerto 3002).
VITE_API_BASE_URL=http://localhost:3002/api

# Inicio de sesión con Google (opcional). ID de cliente tipo «Aplicación web» creado en Google Cloud Console.
# Es el MISMO valor que GOOGLE_CLIENT_ID en el .env del servidor. Sin definir, no se muestra el botón.
VITE_GOOGLE_CLIENT_ID=
